# ==========================================================================
# SpectraContent Intelligence OS — local development environment template
# Copy to `.env` and adjust. NEVER commit a real `.env` file.
# All values below are LOCAL DEVELOPMENT defaults only — not secrets.
# ==========================================================================

NODE_ENV=development

# --- PostgreSQL (docker compose service: postgres) ---
DATABASE_URL=postgresql://spectra:spectra_local_dev@localhost:5432/spectra?schema=public

# --- Redis (docker compose service: redis) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (docker compose service: minio) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=spectra-local
STORAGE_SECRET_KEY=spectra_local_dev
STORAGE_BUCKET=spectra-dev
STORAGE_FORCE_PATH_STYLE=true

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated browser origins allowed for CORS and the CSRF origin check.
API_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- AI (Phase 3, optional) ---
# Leave ANTHROPIC_API_KEY unset to run with AI generation honestly disabled
# (draft endpoints return 503; the UI shows an "not configured" banner).
# When set, evidence-grounded content drafting is enabled (@spectra/ai-anthropic).
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# --- Semantic embeddings (Phase 5A, optional) ---
# Without a key, retrieval falls back to the first-party LEXICAL embedder and
# says so in the API/UI (it matches words, not meaning). Set the SAME value in
# the API and the worker.
# Changing the model or dimensions creates a NEW collection: run
# `POST /v1/workspaces/<id>/knowledge/reembed` afterwards, or existing findings
# will be absent from search (GET knowledge/status reports coverage).
# VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4
# One of 256 | 512 | 1024 | 2048 (voyage-4 family Matryoshka widths).
VOYAGE_EMBEDDING_DIMENSIONS=1024

# --- Research discovery (Phase 5B, optional) ---
# Live web + news search via Brave. Without a key, search discovery is honestly
# unavailable and runs fall back to the RSS feeds configured on the project —
# no result is ever invented. Get a key: https://api-dashboard.search.brave.com/
# BRAVE_SEARCH_API_KEY=

# --- Publishing (Phase 4, optional) ---
# Base64-encoded 32-byte AES-256-GCM key for sealing social-account credentials.
# The API seals credentials with it; the WORKER decrypts them to publish — set
# the SAME value in both processes. Unset => social targets can be registered
# but credentials cannot be stored (honestly refused) and WordPress publishing
# resolves to UNSUPPORTED. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WordPress target: register the site URL as the account handle and the
# credential as "wp-username:application password" (WordPress 5.6+ app password).
# SOCIAL_TOKEN_ENCRYPTION_KEY=
# Key rotation (ADR-0034). The id is stamped into every new ciphertext; retired
# keys stay decrypt-only ("keyId:base64key,keyId:base64key"). Runbook: docs/SECURITY.md §14.
# SOCIAL_TOKEN_ENCRYPTION_KEY_ID=social-v1
# SOCIAL_TOKEN_ENCRYPTION_RETIRED_KEYS=

# --- Social OAuth (Phase 6C, optional) ---
# Connecting LinkedIn, Facebook Pages, Instagram, Threads, YouTube, TikTok, X or
# Pinterest stores a sealed OAuth grant. It does NOT enable publishing — no OAuth
# platform has a publishing adapter yet. A platform is connectable only when BOTH
# its client id and secret are set (half a pair fails boot), the redirect base
# URL is set, and SOCIAL_TOKEN_ENCRYPTION_KEY is set.
#
# Public base URL of this API as platforms reach it. Register, per platform:
#   <SOCIAL_OAUTH_REDIRECT_BASE_URL>/v1/social/oauth/<platform>/callback
# (the Social Accounts page shows the exact value). https in production.
# SOCIAL_OAUTH_REDIRECT_BASE_URL=http://localhost:4000
# Where the callback returns the browser. Must be one of API_CORS_ORIGIN;
# defaults to the first entry.
# WEB_APP_URL=http://localhost:3000
# How long a started flow may take (60-1800 seconds).
# SOCIAL_OAUTH_STATE_TTL_SECONDS=600
#
# Per platform — <PLATFORM> is LINKEDIN, FACEBOOK, INSTAGRAM, THREADS, YOUTUBE,
# TIKTOK, X or PINTEREST (TikTok's "client key" goes in CLIENT_ID):
# SOCIAL_OAUTH_X_CLIENT_ID=
# SOCIAL_OAUTH_X_CLIENT_SECRET=
# Optional overrides of the declared defaults (https in production):
# SOCIAL_OAUTH_X_SCOPES=tweet.read tweet.write users.read offline.access
# SOCIAL_OAUTH_X_AUTHORIZATION_URL=
# SOCIAL_OAUTH_X_TOKEN_URL=
# SOCIAL_OAUTH_X_REVOCATION_URL=

# --- Observability (Phase 6B, optional) ---
# OTLP/HTTP endpoint for distributed tracing. UNSET => tracing is off, the
# OpenTelemetry SDK is never loaded, and each service says so once at boot.
# Set the SAME value in the API and the worker to correlate a request with the
# background job it queued. Span attributes are allow-listed (ADR-0033), so no
# prompt, document text or credential is ever exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Comma-separated key=value pairs sent with every export, e.g. a collector auth
# header. Treated as a secret: never logged, never echoed in a validation error.
# OTEL_EXPORTER_OTLP_HEADERS=

# --- LinkedIn adapter (Phase 6D, optional) ---
# Every versioned LinkedIn call sends this version (YYYYMM). LinkedIn supports a
# version for at least a year; move it forward before the one in use is sunset.
# LINKEDIN_API_VERSION=202608
# Tests only — points the adapter at a local LinkedIn stand-in. Leave unset.
# LINKEDIN_API_BASE_URL=https://api.linkedin.com
# The WORKER needs SOCIAL_TOKEN_ENCRYPTION_KEY and, to refresh tokens before
# publishing, the same SOCIAL_OAUTH_LINKEDIN_CLIENT_ID/SECRET and redirect base
# URL as the API. Setup: docs/LINKEDIN_SETUP.md.

# --- Meta adapters: Facebook Pages + Instagram (Phase 6E, optional) ---
# Every Graph call uses this version. Meta supports a version for about two
# years; move it forward before the one in use is retired.
# META_GRAPH_API_VERSION=v26.0
# Tests only — points the adapters at a local Graph stand-in. Leave unset.
# META_GRAPH_API_BASE_URL=https://graph.facebook.com
# The WORKER needs SOCIAL_TOKEN_ENCRYPTION_KEY and SOCIAL_OAUTH_FACEBOOK_CLIENT_SECRET
# (every Graph call carries appsecret_proof). Instagram fetches images from
# signed links to STORAGE_ENDPOINT, which must be reachable from the internet;
# a local or private endpoint makes Instagram publishing resolve to UNSUPPORTED.
# Setup: docs/META_SETUP.md.

# --- Worker ---
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_CONCURRENCY=5

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Logging ---
LOG_LEVEL=info
