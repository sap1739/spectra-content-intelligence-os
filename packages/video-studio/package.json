{
  "name": "@spectra/video-studio",
  "version": "0.1.0",
  "description": "Storyboard model, deterministic video render planning, SRT/VTT caption building and FFmpeg argument construction. Pure — no I/O, no process spawning.",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@spectra/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
