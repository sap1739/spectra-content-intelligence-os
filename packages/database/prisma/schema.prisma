// SpectraContent Intelligence OS — Phase 1 foundational schema.
//
// Multi-tenancy: shared database, shared schema. Every tenant-owned table
// carries organizationId (billing boundary) and, where applicable,
// workspaceId (primary isolation boundary). Application code must always
// filter by tenant columns; see packages/database/src/tenant-guard.ts and
// docs/DATABASE_DESIGN.md.
//
// Conventions:
// - UUID primary keys generated by the database (pgcrypto gen_random_uuid).
// - All timestamps are timestamptz stored in UTC; user display timezones are
//   explicit columns (User.timezone, Workspace.timezone).
// - Soft deletion via deletedAt on user-facing entities; AuditLog is
//   append-only and never deleted.
// - The pgvector extension is enabled by migration for Phase 2 embeddings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email    String     @unique
  name     String
  /// IANA timezone for display purposes; storage is always UTC.
  timezone String     @default("UTC")
  locale   String     @default("en")
  status   UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships           Membership[]
  createdResearch       ResearchProject[]      @relation("ResearchProjectCreatedBy")
  auditLogs             AuditLog[]
  credential            Credential?
  workspaceBudgets      WorkspaceBudget[]
  organizationBudgets   OrganizationBudget[]
  budgetOperationLimits BudgetOperationLimit[]
  domainPolicies        DomainPolicy[]
  extractedClaims       ExtractedClaim[]
  claimReviews          ClaimReview[]
  socialOAuthAttempts   SocialOAuthAttempt[]

  @@index([status])
  @@map("users")
}

/// Password credential, separated from User so future factors (passkeys,
/// TOTP) become sibling tables instead of columns. The hash embeds its own
/// scrypt parameters (see @spectra/security passwords.ts). NEVER logged.
model Credential {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

model Organization {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug     String             @unique
  name     String
  status   OrganizationStatus @default(ACTIVE)
  settings Json               @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  memberships           Membership[]
  workspaces            Workspace[]
  brands                Brand[]
  verticals             CustomVertical[]
  researchProjects      ResearchProject[]
  researchRuns          ResearchRun[]
  researchSources       ResearchSource[]
  researchFindings      ResearchFinding[]
  trendCandidates       TrendCandidate[]
  auditLogs             AuditLog[]
  usageEvents           UsageEvent[]
  workspaceBudgets      WorkspaceBudget[]
  organizationBudget    OrganizationBudget?
  budgetOperationLimits BudgetOperationLimit[]
  domainPolicies        DomainPolicy[]
  budgetReservations    BudgetReservation[]
  invitations           Invitation[]
  trendWatchlists       TrendWatchlist[]
  campaigns             Campaign[]
  contentItems          ContentItem[]
  contentDrafts         ContentDraft[]
  audiencePersonas      AudiencePersona[]
  contentPillars        ContentPillar[]
  topicIdeas            TopicIdea[]
  campaignBriefs        CampaignBrief[]
  scheduleEntries       ContentScheduleEntry[]
  mediaAssets           MediaAsset[]
  socialAccounts        SocialAccount[]
  socialConnections     SocialConnection[]
  socialOAuthAttempts   SocialOAuthAttempt[]
  socialMediaUploads    SocialMediaUpload[]

  @@map("organizations")
}

enum MembershipRole {
  ORG_OWNER
  ORG_ADMIN
  WORKSPACE_ADMIN
  RESEARCHER
  CONTENT_STRATEGIST
  CREATOR
  DESIGNER
  EDITOR
  APPROVER
  PUBLISHER
  ANALYST
  CLIENT_REVIEWER
  READ_ONLY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Membership {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @db.Uuid
  userId           String           @db.Uuid
  role             MembershipRole
  /// Explicit permission grants beyond the role bundle (permission strings).
  extraPermissions String[]         @default([])
  /// Optional restriction to specific workspaces; empty = all in org.
  workspaceIds     String[]         @default([]) @db.Uuid
  status           MembershipStatus @default(ACTIVE)
  invitedById      String?          @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Link-based invitation (no SMTP yet — the inviter shares the register
/// link; registering with the invited email joins automatically).
model Invitation {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  email          String
  role           MembershipRole @default(READ_ONLY)
  token          String         @unique
  invitedById    String?        @db.Uuid
  expiresAt      DateTime       @db.Timestamptz(6)
  acceptedAt     DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
  @@map("invitations")
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

model Workspace {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  slug           String
  name           String
  description    String?
  /// Default display timezone for calendars; storage remains UTC.
  timezone       String          @default("UTC")
  settings       Json            @default("{}")
  status         WorkspaceStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brands                Brand[]
  verticals             CustomVertical[]
  researchProjects      ResearchProject[]
  researchRuns          ResearchRun[]
  researchSources       ResearchSource[]
  researchFindings      ResearchFinding[]
  trendCandidates       TrendCandidate[]
  trendWatchlists       TrendWatchlist[]
  campaigns             Campaign[]
  contentItems          ContentItem[]
  contentDrafts         ContentDraft[]
  audiencePersonas      AudiencePersona[]
  contentPillars        ContentPillar[]
  topicIdeas            TopicIdea[]
  campaignBriefs        CampaignBrief[]
  scheduleEntries       ContentScheduleEntry[]
  mediaAssets           MediaAsset[]
  socialAccounts        SocialAccount[]
  socialConnections     SocialConnection[]
  socialOAuthAttempts   SocialOAuthAttempt[]
  socialMediaUploads    SocialMediaUpload[]
  usageEvents           UsageEvent[]
  workspaceBudget       WorkspaceBudget?
  budgetOperationLimits BudgetOperationLimit[]
  domainPolicies        DomainPolicy[]
  budgetReservations    BudgetReservation[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("workspaces")
}

// ---------------------------------------------------------------------------
// Brand & custom vertical
// ---------------------------------------------------------------------------

enum BrandStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Brand {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  workspaceId    String      @db.Uuid
  slug           String
  name           String
  description    String?
  websiteUrl     String?
  /// Brand voice: tone, personality, do-nots, example phrases.
  voice          Json?
  guidelines     Json        @default("{}")
  languages      String[]    @default([])
  status         BrandStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  researchProjects ResearchProject[]
  campaigns        Campaign[]
  contentItems     ContentItem[]

  @@unique([workspaceId, slug])
  @@index([organizationId])
  @@index([workspaceId, status])
  @@map("brands")
}

enum VerticalStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Fully user-defined vertical. Industry fields are free text on purpose —
/// no hard-coded industry list. Structured collections live in typed JSONB
/// validated by @spectra/contracts customVerticalSchema at the API boundary.
model CustomVertical {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String         @db.Uuid
  workspaceId              String         @db.Uuid
  slug                     String
  name                     String
  description              String?
  industry                 String?
  subIndustry              String?
  businessModel            String?
  products                 String[]       @default([])
  services                 String[]       @default([])
  /// [{ name, description?, roles[], seniority? }]
  targetAudiences          Json           @default("[]")
  customerPainPoints       String[]       @default([])
  geographies              String[]       @default([])
  languages                String[]       @default([])
  /// [{ name, websiteUrl?, notes? }]
  competitors              Json           @default("[]")
  keywords                 String[]       @default([])
  excludedKeywords         String[]       @default([])
  trustedDomains           String[]       @default([])
  blockedDomains           String[]       @default([])
  preferredPublications    String[]       @default([])
  regulatoryConsiderations String[]       @default([])
  /// [{ name, startMonth?, endMonth?, notes? }]
  seasonalEvents           Json           @default("[]")
  commercialObjectives     String[]       @default([])
  contentObjectives        String[]       @default([])
  preferredPlatforms       String[]       @default([])
  /// [{ criterion, weight }] — brand-specific relevance criteria for scoring.
  relevanceCriteria        Json           @default("[]")
  status                   VerticalStatus @default(DRAFT)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  researchProjects ResearchProject[]
  trendCandidates  TrendCandidate[]
  campaigns        Campaign[]
  contentItems     ContentItem[]

  @@unique([workspaceId, slug])
  @@index([organizationId])
  @@index([workspaceId, status])
  @@map("custom_verticals")
}

// ---------------------------------------------------------------------------
// Research
// ---------------------------------------------------------------------------

enum ResearchProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model ResearchProject {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                @db.Uuid
  workspaceId          String                @db.Uuid
  verticalId           String?               @db.Uuid
  brandId              String?               @db.Uuid
  name                 String
  description          String?
  /// The user's research objective in their own words.
  objective            String?
  status               ResearchProjectStatus @default(DRAFT)
  createdById          String?               @db.Uuid
  /// Recurring-run cadence; null = manual runs only. The worker dispatcher
  /// reads these when the per-project scheduler fires.
  scheduleEveryMinutes Int?
  scheduleFeedUrls     String[]              @default([])

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vertical     CustomVertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  brand        Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("ResearchProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  runs          ResearchRun[]
  sources       ResearchSource[]
  findings      ResearchFinding[]
  trends        TrendCandidate[]
  claims        ExtractedClaim[]
  citations     Citation[]
  evidencePacks EvidencePack[]

  @@index([workspaceId, status])
  @@index([organizationId])
  @@map("research_projects")
}

enum ResearchRunStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
  CANCELLED
}

enum ResearchRunTrigger {
  MANUAL
  SCHEDULED
  API
}

model ResearchRun {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @db.Uuid
  workspaceId    String             @db.Uuid
  projectId      String             @db.Uuid
  status         ResearchRunStatus  @default(PENDING)
  trigger        ResearchRunTrigger @default(MANUAL)
  /// Planned queries: [{ providerKind, queryText, language?, geography? }]
  queryPlan      Json               @default("[]")
  currentStage   String?
  startedAt      DateTime?          @db.Timestamptz(6)
  completedAt    DateTime?          @db.Timestamptz(6)
  failureReason  String?
  /// { queriesPlanned, sourcesDiscovered, findingsExtracted, ... }
  stats          Json               @default("{}")
  createdById    String?            @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sources  ResearchSource[]
  findings ResearchFinding[]

  @@index([projectId, status])
  @@index([workspaceId, status])
  @@map("research_runs")
}

enum SourceCategory {
  WEB
  NEWS
  BLOG
  ACADEMIC
  SOCIAL
  VIDEO
  PODCAST
  COMMUNITY
  DOCUMENT
  INTERNAL
  OTHER
}

enum SourceProcessingStatus {
  DISCOVERED
  FETCHED
  EXTRACTED
  NORMALIZED
  DEDUPLICATED
  ANALYZED
  FAILED
  SKIPPED
  /// robots.txt disallowed the fetch. Kept, never fetched, never pretended fetched.
  ROBOTS_BLOCKED
  /// The domain is blocked for this workspace/vertical; ineligible as evidence.
  BLOCKED_DOMAIN
}

/// Outcome of the robots.txt check for a source (ADR-0030).
enum RobotsDecision {
  ALLOWED
  DISALLOWED
  /// robots.txt could not be retrieved. We proceed, and record that we did not
  /// actually verify permission — "unavailable" is not "allowed".
  UNAVAILABLE
  /// No fetch was attempted (feed item, snippet-only by configuration).
  NOT_CHECKED
}

/// How much age has eroded confidence in a source (ADR-0030).
enum StalenessStatus {
  FRESH
  AGING
  STALE
  /// Reference material whose value does not decay with age.
  EVERGREEN
  /// No publication date was stated — decay cannot be computed honestly.
  UNKNOWN
}

model ResearchSource {
  id                      String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String                         @db.Uuid
  workspaceId             String                         @db.Uuid
  projectId               String                         @db.Uuid
  runId                   String?                        @db.Uuid
  url                     String
  canonicalUrl            String?
  /// SHA-256 of the normalized URL — exact-duplicate detection per workspace.
  urlHash                 String
  title                   String?
  publisher               String?
  author                  String?
  publishedAt             DateTime?                      @db.Timestamptz(6)
  retrievedAt             DateTime                       @db.Timestamptz(6)
  language                String?
  geography               String?
  category                SourceCategory                 @default(WEB)
  credibilityScore        Float?
  freshnessScore          Float?
  duplicateOfSourceId     String?                        @db.Uuid
  duplicateClusterKey     String?
  /// SHA-256 of extracted content — near-duplicate clustering input.
  contentHash             String?
  /// { license?, rightsHolder?, attributionRequired?, usageNotes? }
  copyright               Json?
  /// { providerId, providerKind, requestRef?, retrievedAt, pipelineVersion? }
  provenance              Json
  /// TRUE when the body is a search snippet because the page was not fetched
  /// (blocked by robots, unreachable, or budget-capped). Promoted from
  /// provenance JSON to a column so evidence selection can filter on it.
  snippetOnly             Boolean                        @default(false)
  /// Set when this source is a document rather than a web page (ADR-0031).
  documentType            ExtractedDocumentType?
  documentPageCount       Int?
  /// Populated ONLY when extraction was attempted and failed — the code says
  /// why, so a document source is never silently thin.
  extractionFailureCode   DocumentExtractionFailureCode?
  robotsDecision          RobotsDecision                 @default(NOT_CHECKED)
  robotsCheckedAt         DateTime?                      @db.Timestamptz(6)
  /// Why this source is or is not usable as evidence — always populated.
  evidenceEligible        Boolean                        @default(true)
  evidenceExclusionReason String?
  stalenessStatus         StalenessStatus                @default(UNKNOWN)
  /// Distinct-publisher weight for diversity: 1 for an original, <1 for a
  /// member of a syndication cluster so re-runs of one story do not read as
  /// independent corroboration.
  diversityWeight         Float                          @default(1)
  processingStatus        SourceProcessingStatus         @default(DISCOVERED)
  metadata                Json                           @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      ResearchProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run          ResearchRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  duplicateOf  ResearchSource?  @relation("SourceDuplicates", fields: [duplicateOfSourceId], references: [id], onDelete: SetNull)
  duplicates   ResearchSource[] @relation("SourceDuplicates")

  findings  ResearchFinding[]
  snapshots SourceSnapshot[]

  @@unique([workspaceId, urlHash])
  @@index([projectId, processingStatus])
  @@index([workspaceId, category])
  @@index([duplicateClusterKey])
  @@map("research_sources")
}

/// Immutable capture of a source at retrieval time. Raw bytes live in
/// tenant-scoped object storage under `storageKey`; the row is the index.
model SourceSnapshot {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                   @db.Uuid
  workspaceId      String                   @db.Uuid
  sourceId         String                   @db.Uuid
  retrievedAt      DateTime                 @db.Timestamptz(6)
  /// SHA-256 of the captured content.
  contentHash      String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  extractionStatus SnapshotExtractionStatus @default(PENDING)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)

  source   ResearchSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  findings ResearchFinding[]

  @@index([sourceId])
  @@index([workspaceId, contentHash])
  @@map("source_snapshots")
}

enum SnapshotExtractionStatus {
  PENDING
  EXTRACTED
  FAILED
}

enum FindingStatus {
  PENDING_REVIEW
  VALIDATED
  REJECTED
  STALE
}

model ResearchFinding {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String         @db.Uuid
  workspaceId              String         @db.Uuid
  projectId                String         @db.Uuid
  runId                    String?        @db.Uuid
  sourceId                 String         @db.Uuid
  snapshotId               String?        @db.Uuid
  summary                  String
  excerpt                  String?
  /// { startOffset?, endOffset?, selector?, page? }
  excerptLocation          Json?
  confidence               Float?
  credibilityScore         Float?
  freshnessScore           Float?
  language                 String?
  geography                String?
  duplicateClusterKey      String?
  sourceCategory           SourceCategory @default(WEB)
  topics                   String[]       @default([])
  entities                 String[]       @default([])
  corroboratedByFindingIds String[]       @default([]) @db.Uuid
  /// { license?, rightsHolder?, attributionRequired?, usageNotes? }
  copyright                Json?
  /// { providerId, providerKind, requestRef?, retrievedAt, pipelineVersion? }
  provenance               Json
  status                   FindingStatus  @default(PENDING_REVIEW)
  processingStage          String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run          ResearchRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  source       ResearchSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshot     SourceSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  citations    Citation[]

  @@index([projectId, status])
  @@index([sourceId])
  @@index([workspaceId, status])
  @@index([duplicateClusterKey])
  @@map("research_findings")
}

// ---------------------------------------------------------------------------
// Evidence layer: claims, citations, evidence packs, knowledge chunks
// ---------------------------------------------------------------------------

enum ClaimType {
  FACTUAL
  STATISTIC
  PREDICTION
  OPINION
  QUOTE
}

enum ClaimVerificationStatus {
  UNVERIFIED
  CORROBORATED
  DISPUTED
  VERIFIED
  REJECTED
}

/// Heuristically extracted claims (ADR-0016). One row per normalized claim
/// per project; corroboration = supported by ≥2 distinct sources.
model ExtractedClaim {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                      @db.Uuid
  workspaceId            String                      @db.Uuid
  projectId              String                      @db.Uuid
  text                   String
  /// titleKey-normalized claim text — the per-project dedupe identity.
  normalizedKey          String
  claimType              ClaimType                   @default(FACTUAL)
  verificationStatus     ClaimVerificationStatus     @default(UNVERIFIED)
  supportingFindingIds   String[]                    @default([]) @db.Uuid
  /// Distinct sources backing the claim, INCLUDING syndicated copies.
  sourceCount            Int                         @default(1)
  /// Distinct INDEPENDENT sources — syndicated copies of one story collapse to
  /// one. This, not `sourceCount`, is what corroboration means (ADR-0032).
  independentSourceCount Int                         @default(1)
  /// Cluster identity: claims asserting the same thing share it, so the same
  /// fact restated across outlets is corroboration rather than a new claim.
  clusterKey             String?
  /// Citations that actually support this claim. Never populated speculatively.
  supportingCitationIds  String[]                    @default([]) @db.Uuid
  confidence             Float?
  confidenceLevel        ClaimConfidenceLevel        @default(UNKNOWN)
  /// Age-based confidence for TIME-SENSITIVE claims (statistics, forecasts).
  freshnessStatus        ClaimFreshnessStatus        @default(UNKNOWN)
  /// Publication date of the NEWEST supporting source — drives staleness.
  latestSupportAt        DateTime?                   @db.Timestamptz(6)
  /// Operator-marked: this claim does not decay (definitions, standards).
  evergreen              Boolean                     @default(false)
  /// Whether this claim may ground generated content, and why.
  eligibility            EvidenceEligibilityDecision @default(WEAK)
  eligibilityReason      String?
  reviewStatus           ClaimReviewStatus           @default(NOT_REQUIRED)
  reviewedById           String?                     @db.Uuid
  reviewedAt             DateTime?                   @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  project        ResearchProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy     User?                @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  citations      Citation[]
  reviews        ClaimReview[]
  contradictions ClaimContradiction[] @relation("ClaimContradictionSubject")
  contradicting  ClaimContradiction[] @relation("ClaimContradictionCounterpart")

  @@unique([projectId, normalizedKey])
  @@index([workspaceId, verificationStatus])
  @@index([projectId, clusterKey])
  @@index([workspaceId, eligibility])
  @@index([workspaceId, reviewStatus])
  @@map("extracted_claims")
}

/// How much confidence the evidence supports for one claim.
enum ClaimConfidenceLevel {
  /// Multiple independent sources agree.
  HIGH
  /// Two independent sources, or one highly credible one.
  MEDIUM
  /// A single source, or only snippet-derived support.
  LOW
  /// Actively contradicted by other evidence.
  CONTESTED
  /// Not yet assessed.
  UNKNOWN
}

/// Age-based standing for time-sensitive claims (ADR-0032).
enum ClaimFreshnessStatus {
  CURRENT
  AGING
  STALE
  /// Explicitly marked as not decaying.
  EVERGREEN
  /// No supporting source stated a date — decay cannot be computed honestly.
  UNKNOWN
}

/// Whether a claim may ground generated content.
enum EvidenceEligibilityDecision {
  /// Corroborated by independent sources; preferred for generation.
  ELIGIBLE
  /// Usable, but thin — surfaced to the operator as limited evidence.
  WEAK
  /// Must not be used until a human decides (contradicted, or stale + risky).
  REQUIRES_REVIEW
  /// Never usable as evidence.
  BLOCKED
}

enum ClaimReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
  /// Reviewer asked for more research before deciding.
  MORE_RESEARCH_REQUESTED
}

/// Audit trail of every human decision on a claim. Append-only.
model ClaimReview {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  workspaceId    String            @db.Uuid
  claimId        String            @db.Uuid
  action         ClaimReviewAction
  /// Required for REJECT and REQUEST_MORE_RESEARCH — a decision without a
  /// stated reason is not reviewable by the next person.
  note           String?
  reviewerId     String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  claim    ExtractedClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reviewer User?          @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, claimId, createdAt])
  @@map("claim_reviews")
}

enum ClaimReviewAction {
  APPROVE
  REJECT
  REQUEST_MORE_RESEARCH
}

/// A detected conflict between two claims. Surfaced, never hidden — suppressing
/// conflicting evidence is the failure mode this whole layer exists to prevent.
model ClaimContradiction {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                   @db.Uuid
  workspaceId        String                   @db.Uuid
  projectId          String                   @db.Uuid
  claimId            String                   @db.Uuid
  conflictingClaimId String                   @db.Uuid
  kind               ClaimContradictionKind
  /// What specifically conflicts, e.g. "40% vs 25% for the same subject".
  detail             String
  status             ClaimContradictionStatus @default(OPEN)
  resolvedById       String?                  @db.Uuid
  resolvedAt         DateTime?                @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)

  claim            ExtractedClaim @relation("ClaimContradictionSubject", fields: [claimId], references: [id], onDelete: Cascade)
  conflictingClaim ExtractedClaim @relation("ClaimContradictionCounterpart", fields: [conflictingClaimId], references: [id], onDelete: Cascade)

  @@unique([claimId, conflictingClaimId])
  @@index([workspaceId, status])
  @@map("claim_contradictions")
}

enum ClaimContradictionKind {
  /// Same subject, materially different numbers.
  NUMERIC_CONFLICT
  /// One asserts, the other negates.
  NEGATION
  /// Same subject, incompatible direction (grew vs fell).
  DIRECTIONAL_CONFLICT
}

enum ClaimContradictionStatus {
  OPEN
  /// A human decided which claim stands.
  RESOLVED
  /// A human judged it a false positive.
  DISMISSED
}

/// First-class citation: finding ↔ source (+snapshot) with a byte locator.
/// The audit anchor behind every statement (ADR-0011).
model Citation {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @db.Uuid
  workspaceId    String              @db.Uuid
  projectId      String              @db.Uuid
  findingId      String              @db.Uuid
  sourceId       String              @db.Uuid
  snapshotId     String?             @db.Uuid
  claimId        String?             @db.Uuid
  url            String
  title          String?
  publisher      String?
  publishedAt    DateTime?           @db.Timestamptz(6)
  retrievedAt    DateTime            @db.Timestamptz(6)
  excerpt        String?
  startOffset    Int?
  endOffset      Int?
  /// Where inside a document this citation points (Phase 5G, ADR-0031).
  /// NULL for web-page citations, which have no internal structure.
  anchorKind     DocumentAnchorKind?
  /// 1-based page (PDF).
  pageNumber     Int?
  /// 0-based section index (DOCX/Markdown).
  sectionOrder   Int?
  /// Display form, e.g. "p. 12" or "§ Methodology".
  anchorLabel    String?
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  finding ResearchFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  claim   ExtractedClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([findingId])
  @@index([claimId])
  @@map("citations")
}

enum EvidencePackStatus {
  DRAFT
  READY
  STALE
  ARCHIVED
}

/// Curated bundle of findings/claims/citations per trend topic — the input
/// contract for content generation (Phase 3).
model EvidencePack {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @db.Uuid
  workspaceId          String             @db.Uuid
  projectId            String             @db.Uuid
  trendCandidateId     String?            @db.Uuid
  topicKey             String
  title                String
  summary              String?
  status               EvidencePackStatus @default(DRAFT)
  findingIds           String[]           @default([]) @db.Uuid
  claimIds             String[]           @default([]) @db.Uuid
  citationIds          String[]           @default([]) @db.Uuid
  /// Forward lineage: which generated content consumed this pack.
  usedByContentItemIds String[]           @default([]) @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, topicKey])
  @@index([workspaceId, status])
  @@map("evidence_packs")
}

/// Embedded knowledge chunks (pgvector, ADR-0005/0016). Phase 2 embeds
/// research findings (documentId = source id, metadata.kind marks it);
/// uploaded documents join in Phase 3. Vector ops via PgVectorStore raw SQL.
model DocumentChunk {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                 @db.Uuid
  workspaceId       String                 @db.Uuid
  /// Collection isolates embedding models — one model per collection.
  collection        String
  documentId        String                 @db.Uuid
  index             Int                    @default(0)
  text              String
  metadata          Json                   @default("{}")
  embeddingProvider String
  embeddingModel    String
  dimensions        Int
  /// Unconstrained pgvector column: collections carry different widths (lexical
  /// 256, voyage-4 up to 2048) and must coexist. `dimensions` + `collection`
  /// discriminate; search always filters by collection so widths never mix.
  embedding         Unsupported("vector")?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId, workspaceId, collection])
  @@index([documentId])
  @@map("document_chunks")
}

/// Keyword watchlist: fires SCORE_THRESHOLD alerts when a watched topic's
/// score first crosses the threshold in a run.
model TrendWatchlist {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  name           String
  keywords       String[] @default([])
  threshold      Float    @default(0.7)
  createdById    String?  @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("trend_watchlists")
}

enum TrendAlertType {
  STATE_CHANGE
  SCORE_THRESHOLD
  NEW_EVIDENCE
  RISK_FLAG
}

model TrendAlert {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @db.Uuid
  workspaceId      String         @db.Uuid
  trendCandidateId String         @db.Uuid
  alertType        TrendAlertType
  message          String
  triggeredAt      DateTime       @default(now()) @db.Timestamptz(6)
  acknowledgedAt   DateTime?      @db.Timestamptz(6)
  acknowledgedById String?        @db.Uuid

  trendCandidate TrendCandidate @relation(fields: [trendCandidateId], references: [id], onDelete: Cascade)

  @@index([workspaceId, acknowledgedAt])
  @@map("trend_alerts")
}

// ---------------------------------------------------------------------------
// Trend intelligence
// ---------------------------------------------------------------------------

enum TrendState {
  EMERGING
  ACCELERATING
  PEAKING
  STABLE
  DECLINING
  SEASONAL
  EVERGREEN
  UNVERIFIED
  REJECTED
}

model TrendCandidate {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String     @db.Uuid
  workspaceId          String     @db.Uuid
  projectId            String?    @db.Uuid
  verticalId           String?    @db.Uuid
  /// Stable identity for upserts within a project (e.g. normalized topic keyword).
  topicKey             String?
  title                String
  summary              String?
  state                TrendState @default(UNVERIFIED)
  /// Normalized [0,1] score from the latest scoring run.
  normalizedScore      Float?
  /// Full TrendScoreResult (components + explanation) — always explainable.
  latestScore          Json?
  scoringConfigId      String?
  scoringConfigVersion String?
  /// Trend signals referenced by this candidate.
  signals              Json       @default("[]")
  sourceIds            String[]   @default([]) @db.Uuid
  findingIds           String[]   @default([]) @db.Uuid
  firstSeenAt          DateTime?  @db.Timestamptz(6)
  lastSeenAt           DateTime?  @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      ResearchProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vertical     CustomVertical?  @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  alerts       TrendAlert[]

  @@index([workspaceId, state])
  @@index([projectId, topicKey])
  @@index([workspaceId, normalizedScore])
  @@map("trend_candidates")
}

// ---------------------------------------------------------------------------
// Content strategy & generation (Phase 3)
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum FunnelStage {
  AWARENESS
  CONSIDERATION
  CONVERSION
  RETENTION
  ADVOCACY
}

enum ContentType {
  POST
  ARTICLE
  THREAD
  VIDEO_SCRIPT
  IMAGE
  CAROUSEL
  SHORT_VIDEO
  LONG_VIDEO
  AUDIO
  EMAIL
  OTHER
}

/// Mirrors CONTENT_LIFECYCLE_STATES in @spectra/contracts — never scattered strings.
enum ContentLifecycleState {
  IDEA
  RESEARCHING
  RESEARCH_READY
  BRIEF
  STRATEGY
  DRAFT
  GENERATED
  EDITING
  REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  ARCHIVED
}

model Campaign {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  workspaceId    String         @db.Uuid
  brandId        String?        @db.Uuid
  verticalId     String?        @db.Uuid
  name           String
  description    String?
  status         CampaignStatus @default(DRAFT)
  /// Display timezone for planning; storage remains UTC.
  timezone       String         @default("UTC")
  startAt        DateTime?      @db.Timestamptz(6)
  endAt          DateTime?      @db.Timestamptz(6)
  createdById    String?        @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vertical     CustomVertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  brand        Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  contentItems ContentItem[]
  brief        CampaignBrief?

  @@index([workspaceId, status])
  @@map("campaigns")
}

/// A durable content object. Every item can be traced to the evidence pack,
/// citations and findings it was grounded on, plus each generation attempt.
model ContentItem {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                @db.Uuid
  workspaceId       String                @db.Uuid
  campaignId        String?               @db.Uuid
  brandId           String?               @db.Uuid
  verticalId        String?               @db.Uuid
  title             String
  contentType       ContentType           @default(POST)
  lifecycleState    ContentLifecycleState @default(IDEA)
  funnelStage       FunnelStage?
  /// The operator's objective for this piece, in their own words (trusted).
  objective         String?
  /// Current best body (latest accepted draft, or human edit).
  body              String?
  /// Human edit history (HumanEditRecord[]) and approval decisions (ApprovalRecord[]).
  humanEdits        Json                  @default("[]")
  approvals         Json                  @default("[]")
  /// Latest moderation verdict; null = never moderated.
  moderation        Json?
  /// Grounding lineage — which evidence this item draws on. Never fabricated.
  evidencePackId    String?               @db.Uuid
  researchProjectId String?               @db.Uuid
  topicKey          String?
  findingIds        String[]              @default([]) @db.Uuid
  citationIds       String[]              @default([]) @db.Uuid
  createdById       String?               @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign        Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  brand           Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  vertical        CustomVertical?        @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  drafts          ContentDraft[]
  scheduleEntries ContentScheduleEntry[]

  @@index([workspaceId, lifecycleState])
  @@index([campaignId])
  @@map("content_items")
}

enum ContentDraftStatus {
  GENERATING
  READY
  FAILED
}

/// One AI generation attempt. Records the exact citations/findings supplied as
/// grounding plus the model and prompt version — outputs are attributable and
/// regressions bisectable. Citations here are the ones the draft was grounded
/// on, never fabricated post-hoc.
model ContentDraft {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @db.Uuid
  workspaceId        String             @db.Uuid
  contentItemId      String             @db.Uuid
  status             ContentDraftStatus @default(GENERATING)
  body               String?
  /// Grounding actually supplied to the model for THIS draft.
  evidencePackId     String?            @db.Uuid
  citationIds        String[]           @default([]) @db.Uuid
  findingIds         String[]           @default([]) @db.Uuid
  /// Generation record — versioned for attribution (GenerationRecord contract).
  modelProvider      String?
  modelName          String?
  modelVersion       String?
  promptTemplateId   String?
  promptVersion      String?
  usageInputTokens   Int?
  usageOutputTokens  Int?
  finishReason       String?
  failureReason      String?
  /// CitationValidation — which [n] markers map to supplied sources vs dangling.
  citationValidation Json?
  createdById        String?            @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, createdAt])
  @@map("content_drafts")
}

// ---------------------------------------------------------------------------
// Strategy entities (Phase 3C)
// ---------------------------------------------------------------------------

model AudiencePersona {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @db.Uuid
  workspaceId        String   @db.Uuid
  name               String
  description        String?
  roles              String[] @default([])
  seniority          String?
  industries         String[] @default([])
  painPoints         String[] @default([])
  goals              String[] @default([])
  preferredPlatforms String[] @default([])
  languages          String[] @default([])
  createdById        String?  @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("audience_personas")
}

model ContentPillar {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  /// Optional brand association (plain column — no FK, mirrors ContentItem lineage).
  brandId        String?  @db.Uuid
  name           String
  description    String?
  keywords       String[] @default([])
  createdById    String?  @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("content_pillars")
}

enum TopicIdeaStatus {
  PROPOSED
  SHORTLISTED
  IN_USE
  DISCARDED
}

/// A candidate topic, optionally traceable to the research it came from.
model TopicIdea {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String          @db.Uuid
  workspaceId       String          @db.Uuid
  title             String
  description       String?
  pillarId          String?         @db.Uuid
  verticalId        String?         @db.Uuid
  status            TopicIdeaStatus @default(PROPOSED)
  /// Research lineage (plain columns) — where the idea is grounded.
  evidencePackId    String?         @db.Uuid
  findingIds        String[]        @default([]) @db.Uuid
  trendCandidateIds String[]        @default([]) @db.Uuid
  citationIds       String[]        @default([]) @db.Uuid
  createdById       String?         @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("topic_ideas")
}

/// One brief per campaign — background, objectives, mandatories and do-nots.
model CampaignBrief {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String   @db.Uuid
  campaignId     String   @unique @db.Uuid
  background     String?
  objectives     String[] @default([])
  keyMessages    String[] @default([])
  mandatories    String[] @default([])
  doNots         String[] @default([])
  tone           String?
  createdById    String?  @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("campaign_briefs")
}

// ---------------------------------------------------------------------------
// Content calendar & scheduling (Phase 3E)
// ---------------------------------------------------------------------------

enum ScheduleEntryStatus {
  SCHEDULED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  // No live publisher wired for the platform — honest terminal state, not a failure.
  UNSUPPORTED
  CANCELLED
}

/// One scheduled placement of a content item on a platform at a UTC instant.
/// Publishing itself arrives in Phase 4; entries stay SCHEDULED until then.
model ContentScheduleEntry {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String              @db.Uuid
  workspaceId         String              @db.Uuid
  contentItemId       String              @db.Uuid
  /// Optional publishing target; when set, the dispatcher attempts to publish.
  socialAccountId     String?             @db.Uuid
  /// Social platform label (validated against socialPlatformSchema at the API).
  platform            String
  /// UTC instant; rendered in the workspace/calendar display timezone.
  scheduledAt         DateTime            @db.Timestamptz(6)
  status              ScheduleEntryStatus @default(SCHEDULED)
  note                String?
  /// Publish idempotency key — dispatching the same entry twice is safe.
  idempotencyKey      String?             @unique
  attemptCount        Int                 @default(0)
  lastAttemptAt       DateTime?           @db.Timestamptz(6)
  failureReason       String?
  /// PublishFailureCode (contracts) — what the UI should offer next.
  failureCode         String?
  /// One image to publish with the post (Phase 6D).
  mediaAssetId        String?             @db.Uuid
  mediaAltText        String?
  /// A platform staging object made for this entry (an Instagram media
  /// container), reused on retry so a publish is never staged twice.
  externalContainerId String?
  externalPostId      String?
  externalUrl         String?
  publishedAt         DateTime?           @db.Timestamptz(6)
  createdById         String?             @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scheduledAt])
  @@index([contentItemId])
  @@index([status, scheduledAt])
  @@map("content_schedule_entries")
}

// ---------------------------------------------------------------------------
// Media assets (Phase 3F)
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

/// A media asset in tenant-rooted object storage. Phase 3F wires real image
/// rendering (sharp); video/audio remain honestly unavailable until ffmpeg.
model MediaAsset {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  workspaceId    String    @db.Uuid
  kind           MediaKind @default(IMAGE)
  /// Tenant-rooted object storage key (org/<id>/ws/<id>/renders|media/…).
  storageKey     String
  mimeType       String
  sizeBytes      Int
  widthPx        Int?
  heightPx       Int?
  durationMs     Int?
  checksum       String?
  /// The asset this was derived from (e.g. the uploaded source image).
  sourceAssetId  String?   @db.Uuid
  /// Rendering engine that produced it (e.g. "sharp").
  engine         String?
  createdById    String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scheduleEntries ContentScheduleEntry[]
  socialUploads   SocialMediaUpload[]

  @@index([workspaceId, createdAt])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Publishing — social accounts (Phase 4)
// ---------------------------------------------------------------------------

enum SocialPlatform {
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TIKTOK
  THREADS
  X
  PINTEREST
  WORDPRESS
  EMAIL
}

/// PENDING = registered target, not yet OAuth-verified (no live adapter wired).
enum SocialAccountStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum SocialAccountKind {
  PROFILE
  PAGE
  CHANNEL
  BUSINESS_ACCOUNT
  SITE
}

/// A publishing target. Any stored credential lives ONLY in `encryptedToken`
/// (AES-256-GCM via @spectra/security) and is NEVER returned by the API;
/// `tokenRef` is an opaque handle. Registered targets start PENDING. Targets
/// found by account discovery through an OAuth connection (ADR-0034) carry
/// `connectionId` and start CONNECTED — they were verified by the platform,
/// though publishing still needs a wired adapter.
model SocialAccount {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String              @db.Uuid
  workspaceId           String              @db.Uuid
  platform              SocialPlatform
  externalAccountId     String
  displayName           String
  kind                  SocialAccountKind   @default(PROFILE)
  status                SocialAccountStatus @default(PENDING)
  scopes                String[]            @default([])
  /// Opaque reference to the sealed credential; never the raw token.
  tokenRef              String?
  /// AES-256-GCM sealed credential. NEVER selected into API responses.
  encryptedToken        String?
  /// Key id that sealed `encryptedToken` — rotation bookkeeping, not a secret.
  credentialKeyId       String?
  /// The OAuth connection this account was discovered through, if any.
  connectionId          String?             @db.Uuid
  /// Allow-listed discovery metadata (primitives only). Never a provider payload.
  discoveryMetadata     Json                @default("{}")
  /// What this account can publish through the adapter (AccountCapabilitySnapshot).
  capabilities          Json                @default("{}")
  capabilitiesCheckedAt DateTime?           @db.Timestamptz(6)
  connectedById         String?             @db.Uuid
  connectedAt           DateTime            @default(now()) @db.Timestamptz(6)
  lastRefreshedAt       DateTime?           @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection   SocialConnection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  mediaUploads SocialMediaUpload[]

  @@index([workspaceId, platform])
  @@index([connectionId])
  @@map("social_accounts")
}

// ---------------------------------------------------------------------------
// Publishing — OAuth connections (Phase 6C, ADR-0034)
// ---------------------------------------------------------------------------

enum SocialConnectionStatus {
  CONNECTED
  /// The access token has expired. Refreshable connections recover via refresh.
  EXPIRED
  /// The platform rejected a refresh; only a new authorization fixes it.
  REAUTH_REQUIRED
  REVOKED
  ERROR
}

/// NOT_AVAILABLE = no discovery adapter is wired for the platform, so nothing
/// was looked up. Distinct from COMPLETE with zero accounts.
enum AccountDiscoveryStatus {
  NOT_AVAILABLE
  COMPLETE
  /// The authorizing profile was found but page/channel discovery failed.
  PARTIAL
  FAILED
}

enum OAuthAttemptMode {
  CONNECT
  RECONNECT
}

enum OAuthAttemptOutcome {
  CONNECTED
  DENIED
  FAILED
}

/// One OAuth grant: the platform authorized Spectra, and this row holds the
/// resulting tokens as ONE sealed bundle (`encryptedCredential`). A connection
/// can yield several publishing destinations (SocialAccount rows) through
/// discovery. `encryptedCredential` is NEVER selected into API responses.
model SocialConnection {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                 @db.Uuid
  workspaceId           String                 @db.Uuid
  platform              SocialPlatform
  status                SocialConnectionStatus @default(CONNECTED)
  label                 String
  /// The platform's subject id when its token response carried one. NULL = not
  /// reported; never invented.
  externalSubjectId     String?
  requestedScopes       String[]               @default([])
  grantedScopes         String[]               @default([])
  /// False when the platform did not say what it granted. `grantedScopes` is
  /// then empty because it is UNKNOWN — not because nothing was granted.
  grantedScopesReported Boolean                @default(false)
  /// AES-256-GCM sealed JSON { accessToken, refreshToken, tokenType }.
  encryptedCredential   String?
  /// Key id that sealed `encryptedCredential` — lets rotation find stale rows.
  credentialKeyId       String?
  hasRefreshToken       Boolean                @default(false)
  accessTokenExpiresAt  DateTime?              @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime?              @db.Timestamptz(6)
  lastRefreshedAt       DateTime?              @db.Timestamptz(6)
  /// Code of the last token failure (e.g. `invalid_grant`). Never a provider body.
  lastErrorCode         String?
  discoveryStatus       AccountDiscoveryStatus @default(NOT_AVAILABLE)
  discoveredAt          DateTime?              @db.Timestamptz(6)
  connectedById         String?                @db.Uuid
  connectedAt           DateTime               @default(now()) @db.Timestamptz(6)
  disconnectedAt        DateTime?              @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts     SocialAccount[]
  attempts     SocialOAuthAttempt[]

  @@index([workspaceId, platform])
  @@index([organizationId, credentialKeyId])
  @@map("social_connections")
}

/// A started OAuth flow, bound to the user and browser session that started
/// it. Only the SHA-256 of `state` is stored. `consumedAt` is set atomically on
/// first use, so a second callback with the same state is a detectable replay.
model SocialOAuthAttempt {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @db.Uuid
  workspaceId           String               @db.Uuid
  userId                String               @db.Uuid
  platform              SocialPlatform
  mode                  OAuthAttemptMode     @default(CONNECT)
  /// Set for RECONNECT (the connection being renewed) and on success.
  connectionId          String?              @db.Uuid
  label                 String
  stateHash             String               @unique
  /// Sealed PKCE verifier; NULL when the platform does not use PKCE.
  encryptedCodeVerifier String?
  redirectUri           String
  requestedScopes       String[]             @default([])
  /// Allow-listed web path the callback returns to.
  returnPath            String
  expiresAt             DateTime             @db.Timestamptz(6)
  consumedAt            DateTime?            @db.Timestamptz(6)
  outcome               OAuthAttemptOutcome?
  failureCode           String?
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   SocialConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@map("social_oauth_attempts")
}

enum SocialMediaUploadStatus {
  /// The platform issued an upload slot and a media id; bytes not yet sent.
  REGISTERED
  UPLOADED
  FAILED
}

/// One asset's upload to one publishing account (Phase 6D, ADR-0035). Lets a
/// retry reuse media the platform already holds instead of uploading again.
/// Holds no credential and no upload URL — only the platform's media id.
model SocialMediaUpload {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                  @db.Uuid
  workspaceId        String                  @db.Uuid
  socialAccountId    String                  @db.Uuid
  mediaAssetId       String                  @db.Uuid
  platform           SocialPlatform
  /// e.g. urn:li:image:... — the platform's own media id.
  externalMediaId    String?
  status             SocialMediaUploadStatus
  /// true when the platform confirmed processing finished (not every token may check).
  verified           Boolean                 @default(false)
  attempts           Int                     @default(0)
  uploadUrlExpiresAt DateTime?               @db.Timestamptz(6)
  lastError          String?
  uploadedAt         DateTime?               @db.Timestamptz(6)
  /// The last post this media was attached to.
  lastPostId         String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, mediaAssetId])
  @@index([organizationId, createdAt])
  @@map("social_media_uploads")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  API_CLIENT
}

/// Append-only. Never updated, never soft-deleted. Sensitive values must be
/// redacted by @spectra/security deepRedact before insertion.
model AuditLog {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  workspaceId    String?        @db.Uuid
  actorType      AuditActorType @default(USER)
  actorUserId    String?        @db.Uuid
  action         String
  resourceType   String
  resourceId     String?
  correlationId  String?
  ip             String?
  userAgent      String?
  changes        Json?
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@map("audit_logs")
}

/// Append-only meter of every billable/rate-limited external operation.
///
/// Recorded ONLY from what a provider actually reports. When a provider does not
/// report token counts, the token columns stay NULL — never 0, which would read
/// as "measured, and it was free". `estimatedCostMicros` is exactly that: an
/// ESTIMATE derived from a versioned local rate table (`rateVersion`), not a
/// vendor invoice. Never present it as an amount charged.
model UsageEvent {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String          @db.Uuid
  workspaceId         String?         @db.Uuid
  kind                UsageKind
  /// Provider + model as reported by the adapter (e.g. "anthropic"/"claude-opus-4-8").
  provider            String
  model               String?
  /// Number of API calls this event covers (usually 1; batched embeds may be more).
  requests            Int             @default(1)
  /// NULL = the provider did not report it. Never coerce to zero.
  inputTokens         Int?
  outputTokens        Int?
  totalTokens         Int?
  bytes               Int?
  /// Estimated cost in millionths of a currency unit; NULL when no rate is known.
  estimatedCostMicros Int?
  /// Rate-table version used for the estimate — makes old rows re-interpretable.
  rateVersion         String?
  /// Set whenever estimatedCostMicros is NULL. Says WHY, never implies zero.
  unpricedReason      UnpricedReason?
  /// Set whenever estimatedCostMicros is non-NULL.
  rateSource          RateSource?
  /// True when a kind that normally reports a quantity reported none — surfaced
  /// as unknown so a token limit never treats it as zero tokens used.
  quantityUnknown     Boolean         @default(false)
  currency            String          @default("USD")
  /// What this spend was for: RESEARCH_RUN/CONTENT_DRAFT/etc + its id.
  resourceType        String?
  resourceId          String?         @db.Uuid
  correlationId       String?
  metadata            Json            @default("{}")
  occurredAt          DateTime        @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, workspaceId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("usage_events")
}

/// What kind of metered work an event covers.
enum UsageKind {
  AI_GENERATION
  AI_EMBEDDING
  WEB_SEARCH
  NEWS_SEARCH
  PAGE_FETCH
  /// Whole-operation counters, so per-kind limits can cap them even when the
  /// underlying spend is metered separately (or is not vendor-billed at all).
  RESEARCH_RUN
  CONTENT_DRAFT
  DOCUMENT_EXTRACTION
  MEDIA_RENDER
  PUBLISH_ATTEMPT
}

/// Why an event carries no cost estimate. NEVER absent on an unpriced row —
/// "no rate" and "free" and "not measured" are different facts and must not
/// collapse into a silent zero.
enum UnpricedReason {
  /// Provider/model has no entry in the rate table.
  NO_RATE_FOR_MODEL
  /// First-party/local work with no vendor charge (lexical embedding, sharp).
  FREE_LOCAL
  /// Real external work we do not pay a vendor per-unit for (page fetches).
  NOT_VENDOR_BILLED
  /// A rate exists but the provider reported no quantity to price.
  NO_MEASURED_QUANTITY
  /// Counter-only row (RESEARCH_RUN, PUBLISH_ATTEMPT) — spend is metered on the
  /// underlying operations, so pricing it here would double-count.
  COUNTER_ONLY
}

/// How confident the stored estimate is.
enum RateSource {
  /// Exact rate for this provider/model.
  EXACT
  /// No exact entry; priced at the most expensive known rate in the same
  /// provider family so spend is over-stated rather than invisible.
  FAMILY_FALLBACK_CONSERVATIVE
}

/// Per-workspace spend ceiling, evaluated before expensive work starts.
///
/// Enforced against ESTIMATED cost from the versioned rate table (ADR-0026),
/// which is approximate and excludes operations with no known rate. That
/// limitation is surfaced in every budget decision rather than hidden, so an
/// operator is never told a precise-looking number that is quietly incomplete.
model WorkspaceBudget {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String            @db.Uuid
  workspaceId        String            @unique @db.Uuid
  /// OFF = record only; WARN = surface but allow; ENFORCE = refuse new work.
  enforcement        BudgetEnforcement @default(WARN)
  /// Calendar-month ceiling in micros. NULL = no ceiling (nothing to exceed).
  monthlyLimitMicros Int?
  /// Percentage of the limit at which status becomes WARN (1-100).
  warnAtPercent      Int               @default(80)
  currency           String            @default("USD")
  updatedById        String?           @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("workspace_budgets")
}

/// How a workspace budget behaves when the ceiling is reached.
enum BudgetEnforcement {
  OFF
  WARN
  ENFORCE
}

/// Optional organization-wide ceiling ABOVE workspace budgets (ADR-0028).
/// Workspace budgets remain primary; a pre-flight evaluates both and the
/// STRICTER decision wins. Aggregates usage across that organization's
/// workspaces only — never across tenants.
model OrganizationBudget {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String            @unique @db.Uuid
  enforcement        BudgetEnforcement @default(WARN)
  monthlyLimitMicros Int?
  warnAtPercent      Int               @default(80)
  currency           String            @default("USD")
  updatedById        String?           @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("organization_budgets")
}

/// A per-operation monthly cap, independent of total estimated spend.
///
/// Exists so operations that are free, unpriced or not vendor-billed can still
/// be bounded: a cost ceiling cannot cap what it cannot price.
/// `workspaceId` NULL = an organization-wide limit for that kind.
model BudgetOperationLimit {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  /// NULL => organization-scoped limit for this kind.
  workspaceId    String?   @db.Uuid
  kind           UsageKind
  /// Max API calls/operations this calendar month. NULL = uncapped.
  maxRequests    Int?
  /// Max tokens this calendar month, where the provider reports them.
  /// Events with unknown quantity are counted as requests but NOT as tokens.
  maxTokens      Int?
  updatedById    String?   @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, workspaceId, kind])
  @@index([organizationId, kind])
  @@map("budget_operation_limits")
}

/// Holds estimated spend for in-flight work so two simultaneous pre-flight
/// checks cannot both pass against the same remaining allowance (ADR-0028).
///
/// Reservations are advisory, not accounting: they are reconciled against real
/// metered usage when the work finishes, and released/ignored once expired so a
/// crashed worker cannot permanently consume an allowance.
model BudgetReservation {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String            @db.Uuid
  workspaceId         String            @db.Uuid
  kind                UsageKind
  /// Estimated cost held. 0 when the operation has no known price — the
  /// reservation then guards per-kind request limits only.
  estimatedCostMicros Int               @default(0)
  /// Requests held against per-kind limits (usually 1).
  requests            Int               @default(1)
  status              ReservationStatus @default(ACTIVE)
  /// Retries must not double-reserve; unique per logical operation.
  idempotencyKey      String            @unique
  resourceType        String?
  resourceId          String?           @db.Uuid
  /// After this, the reservation no longer counts against the budget.
  expiresAt           DateTime          @db.Timestamptz(6)
  releasedAt          DateTime?         @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, status, expiresAt])
  @@map("budget_reservations")
}

enum ReservationStatus {
  /// Held against the budget.
  ACTIVE
  /// Work finished; real usage is in the ledger and this no longer counts.
  RECONCILED
  /// Work never ran (failed/refused); allowance returned.
  RELEASED
}

/// Workspace-level source policy for one domain (ADR-0030).
///
/// Verticals already carry trusted/blocked domain lists; this adds a
/// workspace-wide layer plus an explicit numeric credibility override, so an
/// operator can say "we trust this regulator at 0.95" rather than only
/// "trusted / not trusted".
model DomainPolicy {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String       @db.Uuid
  workspaceId         String       @db.Uuid
  /// Registrable host, lower-cased, no leading "www." — matches subdomains.
  domain              String
  stance              DomainStance @default(NEUTRAL)
  /// Explicit credibility in [0,1]. NULL = derive from stance.
  credibilityOverride Float?
  /// Content here does not decay with age (standards, legislation, docs).
  evergreen           Boolean      @default(false)
  note                String?
  updatedById         String?      @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, domain])
  @@index([organizationId, stance])
  @@map("domain_policies")
}

enum DomainStance {
  TRUSTED
  NEUTRAL
  /// Never usable as evidence unless an operator explicitly overrides.
  BLOCKED
}

/// Cached robots.txt decision per host, so one run does not re-fetch robots.txt
/// for every page and repeat runs stay polite (ADR-0030).
model RobotsCacheEntry {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Scheme + host + port, e.g. "https://example.com".
  origin            String   @unique
  /// Raw rules for our user-agent, already parsed into path prefixes.
  disallow          String[] @default([])
  allow             String[] @default([])
  crawlDelaySeconds Int?
  /// FALSE when robots.txt could not be retrieved — recorded, not assumed.
  retrieved         Boolean  @default(true)
  fetchedAt         DateTime @default(now()) @db.Timestamptz(6)
  expiresAt         DateTime @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("robots_cache_entries")
}

/// Document formats the pipeline can extract (Phase 5G, ADR-0031).
enum ExtractedDocumentType {
  PDF
  DOCX
  TXT
  MARKDOWN
}

/// Where a citation points inside an extracted document.
enum DocumentAnchorKind {
  PAGE
  SECTION
  LINE
  CHARACTER_RANGE
}

/// Why a document could not be turned into evidence. Recorded rather than
/// silently degrading the source to an unexplained snippet.
enum DocumentExtractionFailureCode {
  UNSUPPORTED_MIME
  FILE_TOO_LARGE
  ENCRYPTED
  CORRUPT
  /// Scanned images with no text layer. OCR is deliberately not performed.
  NO_TEXT_LAYER
  PARSER_ERROR
}
