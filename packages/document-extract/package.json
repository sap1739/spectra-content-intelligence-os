{
  "name": "@spectra/document-extract",
  "version": "0.1.0",
  "private": true,
  "description": "Safe PDF/DOCX/TXT/Markdown extraction with page and section citation anchors, size/MIME limits and mandatory prompt-injection scanning.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@spectra/contracts": "workspace:*",
    "@spectra/knowledge-core": "workspace:*",
    "@spectra/research-core": "workspace:*",
    "mammoth": "^1.12.2",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
